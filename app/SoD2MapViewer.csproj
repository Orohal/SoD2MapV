<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.7.2</Version>
    <!-- P07: audit is ON again. Known advisories in CUE4Parse's pinned
         Microsoft.Bcl.Memory 9.0.0 / ImageSharp 3.1.12 are time-boxed waived
         until 2026-12-19 — see docs/NuGet-Audit-Waiver.md. Do not extend
         blindly; re-check when CUE4Parse updates. -->
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202611" />
    <PackageReference Include="CUE4Parse-Conversion" Version="1.2.2.202611" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <!-- C11: BgMaps/FandomMaps use Newtonsoft directly — declare instead of relying on CUE4Parse -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- Offline basemap: fandom blank-map webps are embedded, nothing is fetched at runtime -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\fandom_*.webp" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="lang_de.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="lang_en.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>