<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.6.3</Version>
    <!-- CUE4Parse pins Microsoft.Bcl.Memory 9.0.0 and SixLabors.ImageSharp 3.1.12, whose known
         advisories (NU190*) are not actionable here without breaking the parser. -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202611" />
    <PackageReference Include="CUE4Parse-Conversion" Version="1.2.2.202611" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <!-- Offline basemap: fandom blank-map webps are embedded, nothing is fetched at runtime -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\fandom_*.webp" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>